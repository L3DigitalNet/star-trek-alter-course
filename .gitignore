# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# .NET and test outputs
/src/*/bin/
/src/*/obj/
/tests/*/bin/
/tests/*/obj/
/tools/*/bin/
/tools/*/obj/
TestResults/
# Per-machine link to the pinned SDK cache (scripts/resolve-dotnet.sh). No trailing
# slash: a directory-only pattern does not match a symlink.
/.dotnet
StrykerOutput/
.assetctl/
.tools/agent-lsp/

# Recoverable AssetCtl publication residue beside tracked manifests and assets
/config/assets/catalog/**/*.asset.yaml.assetctl-stage-*
/config/assets/catalog/**/*.asset.yaml.assetctl-backup-*
/src/AlterCourse.Godot/assets/**/*.assetctl-backup-*
