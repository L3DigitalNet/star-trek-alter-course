root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{cs,csx}]
indent_size = 4
indent_style = space
max_line_length = 120

# CSharpier owns whitespace. These settings govern semantic style and analyzer policy.
csharp_style_namespace_declarations = file_scoped:error
csharp_style_prefer_braces = true:error
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
dotnet_style_qualification_for_event = false:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_readonly_field = true:error
dotnet_style_require_accessibility_modifiers = always:error

dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0040.severity = error
dotnet_diagnostic.IDE0044.severity = error
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.MA0004.severity = error
dotnet_diagnostic.MA0009.severity = error
dotnet_diagnostic.MA0015.severity = error
dotnet_diagnostic.MA0040.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.RS0030.severity = error

dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.public_members_pascal_case.severity = error
dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.public_members.applicable_kinds = property, method, field, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, protected_internal

dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.pascal_case.capitalization = pascal_case
