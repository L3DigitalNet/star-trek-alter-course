{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://st-ac.example/schemas/asset-manifest.schema.json",
	"title": "AssetCtl asset manifest version 1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"id",
		"lifecycle",
		"kind",
		"revision",
		"purpose",
		"output",
		"visual",
		"constraints",
		"references",
		"rights",
		"approval"
	],
	"properties": {
		"schema_version": { "const": "1" },
		"id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
		"lifecycle": { "enum": ["placeholder", "candidate", "approved", "deprecated"] },
		"kind": {
			"enum": [
				"icon",
				"map-marker",
				"ship-sprite",
				"emblem",
				"illustration",
				"background",
				"texture",
				"other"
			]
		},
		"revision": { "type": "integer", "minimum": 1 },
		"purpose": { "type": "string", "minLength": 1 },
		"output": { "$ref": "#/$defs/output" },
		"visual": {
			"type": "object",
			"additionalProperties": false,
			"required": ["style_profile", "importance", "tags"],
			"properties": {
				"style_profile": { "type": "string" },
				"importance": { "type": "string" },
				"tags": { "type": "array", "items": { "type": "string" } }
			}
		},
		"constraints": {
			"type": "object",
			"additionalProperties": false,
			"required": ["required", "prohibited"],
			"properties": {
				"required": { "type": "array", "items": { "type": "string" } },
				"prohibited": { "type": "array", "items": { "type": "string" } }
			}
		},
		"references": { "type": "array", "items": { "type": "object" } },
		"rights": { "type": "object" },
		"generation": { "type": ["object", "null"] },
		"validation": { "type": ["object", "null"] },
		"integrity": { "type": ["object", "null"] },
		"approval": { "type": "object" },
		"supersedes": { "type": ["string", "null"] }
	},
	"$defs": {
		"output": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"path",
				"format",
				"width",
				"height",
				"transparency",
				"target_display_sizes"
			],
			"properties": {
				"path": { "type": "string", "pattern": "^src/AlterCourse[.]Godot/assets/" },
				"format": { "enum": ["svg", "png"] },
				"width": { "type": "integer", "minimum": 1, "maximum": 16384 },
				"height": { "type": "integer", "minimum": 1, "maximum": 16384 },
				"transparency": { "enum": ["required", "optional"] },
				"target_display_sizes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 32,
					"items": { "type": "integer", "minimum": 1, "maximum": 8192 }
				}
			}
		}
	}
}
