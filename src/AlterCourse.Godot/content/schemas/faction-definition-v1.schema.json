{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://l3digital.net/star-trek-alter-course/schemas/faction-definition-v1.schema.json",
	"title": "Faction Definition Version 1",
	"type": "object",
	"required": ["schemaVersion", "id", "displayName"],
	"properties": {
		"schemaVersion": { "const": 1 },
		"id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128,
			"pattern": "^[A-Za-z0-9._-]+$"
		},
		"displayName": { "type": "string", "minLength": 1, "maxLength": 64 }
	},
	"additionalProperties": false
}
